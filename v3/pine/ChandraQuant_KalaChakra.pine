//@version=6
// =============================================================================
//  ChandraQuant — Kāla-Chakra
//  Vedic astronomical regime overlay for Indian equity indices.
//
//  This script computes REAL astronomy on the chart. There is no lookup table for
//  the Sun and Moon: their ecliptic longitudes are evaluated from Meeus' periodic
//  series (Astronomical Algorithms, ch. 25 and 47) directly in Pine, then converted
//  to the sidereal zodiac with the Lahiri ayanamsa. Accuracy is ~0.01° for Surya
//  and ~0.02° for Chandra — two orders of magnitude finer than the 13°20' width of
//  a nakshatra — and it works on any bar, any date, past or future, forever.
//
//  Only Guru, Shani and Rahu use an embedded table (monthly nodes, 1996–2036),
//  because they move 0.08°/0.03°/0.05° per day and a series for each would be
//  hundreds of terms for no visible gain. Interpolation error stays under 0.4°.
//
//  Everything drawn here is a deterministic function of time. Nothing is fitted to
//  price, and nothing repaints.
//
//  Companion to the ChandraQuant Alpha Engine (Python). See CLAUDE.md.
// =============================================================================

indicator("ChandraQuant — Kāla-Chakra", shorttitle="ChandraQuant", overlay=true, max_labels_count=500)

// ----------------------------------------------------------------------------- inputs
grpD = "Display"
showBands    = input.bool(true,  "Regime background bands",  group=grpD)
showNakLabel = input.bool(true,  "Nakshatra change markers", group=grpD)
showSyzygy   = input.bool(true,  "Purnima / Amavasya glyphs", group=grpD)
showEclipse  = input.bool(true,  "Grahana (eclipse) shading", group=grpD)
showVishti   = input.bool(true,  "Vishti (Bhadra) karana marks", group=grpD)
showTable    = input.bool(true,  "Info table", group=grpD)
tablePos     = input.string("Top right", "Table position", options=["Top right","Top left","Bottom right","Bottom left"], group=grpD)

grpT = "Trend context"
emaFast = input.int(20,  "Fast EMA", group=grpT)
emaSlow = input.int(50,  "Slow EMA", group=grpT)
emaTrend= input.int(200, "Trend EMA", group=grpT)

// ----------------------------------------------------------------------------- constants
DEG2RAD = 0.017453292519943295
NAK_DEG = 13.333333333333334      // 360 / 27
TITHI_DEG = 12.0
KARANA_DEG = 6.0

norm360(x) =>
    float v = x % 360.0
    v < 0 ? v + 360.0 : v

sind(x) => math.sin(x * DEG2RAD)
cosd(x) => math.cos(x * DEG2RAD)

// ----------------------------------------------------------------------------- time
// Pine's `time` is the bar open in milliseconds UTC. For an NSE daily bar that is
// 03:45 UTC, i.e. the 09:15 IST opening bell — the same instant the Python engine
// evaluates. Julian Day follows directly.
julianDay() => time / 86400000.0 + 2440587.5

// ----------------------------------------------------------------------------- Lahiri ayanamsa
// Anchored at 23.250182° on JD 2435553.5 (1956-01-01), accumulating IAU-2006
// general precession in longitude. Matches Swiss Ephemeris to a few arc-seconds.
ayanamsa(T) =>
    float p  = 5028.796195 * T + 1.1054348 * T * T
    23.250182 + (p + 2201.1312) / 3600.0

// ----------------------------------------------------------------------------- Surya (Meeus ch. 25)
sunLongitude(T) =>
    float L0 = 280.46646 + 36000.76983 * T + 0.0003032 * T * T
    float M  = 357.52911 + 35999.05029 * T - 0.0001537 * T * T
    float C  = (1.914602 - 0.004817 * T - 0.000014 * T * T) * sind(M) + (0.019993 - 0.000101 * T) * sind(2.0 * M) + 0.000289 * sind(3.0 * M)
    float trueLon = L0 + C
    float omega = 125.04 - 1934.136 * T
    norm360(trueLon - 0.00569 - 0.00478 * sind(omega))

// ----------------------------------------------------------------------------- Chandra (Meeus ch. 47)
// The 27 largest periodic terms in longitude. Truncating here costs ~0.02°, which is
// invisible at nakshatra resolution but keeps the script fast on long histories.
moonLongitude(T) =>
    float Lp = 218.3164477 + 481267.88123421 * T - 0.0015786 * T * T + T * T * T / 538841.0 - T * T * T * T / 65194000.0
    float D  = 297.8501921 + 445267.1114034 * T - 0.0018819 * T * T + T * T * T / 545868.0
    float Ms = 357.5291092 + 35999.0502909 * T - 0.0001536 * T * T
    float Mp = 134.9633964 + 477198.8675055 * T + 0.0087414 * T * T + T * T * T / 69699.0
    float F  = 93.2720950 + 483202.0175233 * T - 0.0036539 * T * T - T * T * T / 3526000.0
    float E  = 1.0 - 0.002516 * T - 0.0000074 * T * T

    float s = 0.0
    s := s + 6288774.0 * sind(Mp)
    s := s + 1274027.0 * sind(2.0 * D - Mp)
    s := s +  658314.0 * sind(2.0 * D)
    s := s +  213618.0 * sind(2.0 * Mp)
    s := s -  185116.0 * sind(Ms) * E
    s := s -  114332.0 * sind(2.0 * F)
    s := s +   58793.0 * sind(2.0 * D - 2.0 * Mp)
    s := s +   57066.0 * sind(2.0 * D - Ms - Mp) * E
    s := s +   53322.0 * sind(2.0 * D + Mp)
    s := s +   45758.0 * sind(2.0 * D - Ms) * E
    s := s -   40923.0 * sind(Ms - Mp) * E
    s := s -   34720.0 * sind(D)
    s := s -   30383.0 * sind(Ms + Mp) * E
    s := s +   15327.0 * sind(2.0 * D - 2.0 * F)
    s := s -   12528.0 * sind(Mp + 2.0 * F)
    s := s +   10980.0 * sind(Mp - 2.0 * F)
    s := s +   10675.0 * sind(4.0 * D - Mp)
    s := s +   10034.0 * sind(3.0 * Mp)
    s := s +    8548.0 * sind(4.0 * D - 2.0 * Mp)
    s := s -    7888.0 * sind(2.0 * D + Ms - Mp) * E
    s := s -    6766.0 * sind(2.0 * D + Ms) * E
    s := s -    5163.0 * sind(D - Mp)
    s := s +    4987.0 * sind(D + Ms) * E
    s := s +    4036.0 * sind(2.0 * D - Ms + Mp) * E
    s := s +    3994.0 * sind(2.0 * D + 2.0 * Mp)
    s := s +    3861.0 * sind(4.0 * D)
    s := s +    3665.0 * sind(2.0 * D - 3.0 * Mp)
    norm360(Lp + s / 1000000.0)

// Chandra's ecliptic latitude — needed for eclipse geometry, since an eclipse
// requires a syzygy AND the Moon near a node.
moonLatitude(T) =>
    float D  = 297.8501921 + 445267.1114034 * T - 0.0018819 * T * T
    float Ms = 357.5291092 + 35999.0502909 * T - 0.0001536 * T * T
    float Mp = 134.9633964 + 477198.8675055 * T + 0.0087414 * T * T
    float F  = 93.2720950 + 483202.0175233 * T - 0.0036539 * T * T
    float E  = 1.0 - 0.002516 * T

    float b = 0.0
    b := b + 5128122.0 * sind(F)
    b := b +  280602.0 * sind(Mp + F)
    b := b +  277693.0 * sind(Mp - F)
    b := b +  173237.0 * sind(2.0 * D - F)
    b := b +   55413.0 * sind(2.0 * D - Mp + F)
    b := b +   46271.0 * sind(2.0 * D - Mp - F)
    b := b +   32573.0 * sind(2.0 * D + F)
    b := b +   17198.0 * sind(2.0 * Mp + F)
    b := b +    9266.0 * sind(2.0 * D + Mp - F)
    b := b +    8822.0 * sind(2.0 * Mp - F)
    b := b +    8216.0 * sind(2.0 * D - Ms - F) * E
    b := b +    4324.0 * sind(2.0 * D - 2.0 * Mp - F)
    b / 1000000.0

// ---------------------------------------------------------------------------
// Slow-graha table: sidereal longitudes at regular nodes, linearly interpolated.
// Span 1996-01-01 to 2036-01-01, 30-day nodes, 488 points per graha.
// Guru/Shani/Rahu move 0.08/0.03/0.05 deg per day, so interpolation error stays
// far below one degree - nakshatra boundaries are 13 deg 20' wide.
// Generated by chandraquant/pine/emit.py - do not hand-edit.
// ---------------------------------------------------------------------------
cq_jd0   = 2450083.50000
cq_step  = 30.0
