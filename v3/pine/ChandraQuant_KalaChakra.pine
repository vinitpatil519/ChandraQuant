var float[] cq_shani = array.from(325.600, 328.202, 331.614, 335.315, 338.798, 341.590, 343.259, 343.497, 342.288, 340.122, 337.972, 336.839, 337.252, 339.168, 342.198, 345.827, 349.541, 352.850, 355.294, 356.470, 356.141, 354.460, 352.143, 350.271, 349.721, 350.782, 353.228, 356.592, 360.352, 364.007, 367.083, 369.131, 369.781, 368.899, 366.843, 364.539, 363.089, 363.171, 364.837, 367.726, 371.334, 375.146, 378.680, 381.468, 383.073, 383.172, 381.774, 379.471, 377.350, 376.430, 377.147, 379.348, 382.590, 386.358, 390.155, 393.509, 395.955, 397.071, 396.609, 394.766, 392.370, 390.587, 390.262, 391.577, 394.233, 397.741, 401.595, 405.316, 408.433, 410.483, 411.068, 410.056, 407.873, 405.554, 404.233, 404.519, 406.373, 409.397, 413.093, 416.969, 420.553, 423.374, 424.967, 424.988, 423.469, 421.087, 419.007, 418.230, 419.105, 421.424, 424.737, 428.549, 432.384, 435.770, 438.227, 439.303, 438.745, 436.800, 434.383, 432.685, 432.488, 433.905, 436.613, 440.140, 444.004, 447.735, 450.855, 452.876, 453.381, 452.261, 450.014, 447.731, 446.519, 446.902, 448.801, 451.825, 455.500, 459.354, 462.916, 465.695, 467.205, 467.104, 465.480, 463.088, 461.098, 460.432, 461.368, 463.687, 466.961, 470.723, 474.505, 477.824, 480.179, 481.109, 480.399, 478.379, 476.015, 474.444, 474.349, 475.796, 478.472, 481.937, 485.726, 489.366, 492.362, 494.209, 494.510, 493.232, 490.964, 488.797, 487.734, 488.205, 490.113, 493.090, 496.688, 500.441, 503.865, 506.449, 507.711, 507.367, 505.613, 503.269, 501.448, 500.941, 501.956, 504.275, 507.497, 511.169, 514.816, 517.937, 520.021, 520.639, 519.678, 517.587, 515.347, 513.983, 514.053, 515.576, 518.255, 521.665, 525.345, 528.806, 531.533, 533.033, 532.985, 531.489, 529.230, 527.256, 526.426, 527.068, 529.059, 532.044, 535.581, 539.195, 542.379, 544.619, 545.475, 544.783, 542.879, 540.635, 539.061, 538.807, 540.001, 542.412, 545.644, 549.239, 552.701, 555.513, 557.182, 557.368, 556.101, 553.953, 551.896, 550.821, 551.159, 552.872, 555.650, 559.064, 562.