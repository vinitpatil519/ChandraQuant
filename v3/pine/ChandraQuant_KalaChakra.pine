var float[] cq_rahu = array.from(178.622, 177.033, 175.443, 173.853, 172.263, 170.674, 169.084, 167.494, 165.904, 164.314, 162.725, 161.135, 159.545, 157.955, 156.366, 154.776, 153.186, 151.596, 150.007, 148.417, 146.827, 145.237, 143.648, 142.058, 140.468, 138.878, 137.289, 135.699, 134.109, 132.519, 130.930, 129.340, 127.750, 126.160, 124.570, 122.981, 121.391, 119.801, 118.211, 116.622, 115.032, 113.442, 111.852, 110.263, 108.673, 107.083, 105.493, 103.904, 102.314, 100.724, 99.134, 97.545, 95.955, 94.365, 92.775, 91.186, 89.596, 88.006, 86.416, 84.826, 83.237, 81.647, 80.057, 78.467, 76.878, 75.288, 73.698, 72.108, 70.519, 68.929, 67.339, 65.749, 64.160, 62.570, 60.980, 59.390, 57.801, 56.211, 54.621, 53.031, 51.442, 49.852, 48.262, 46.672, 45.082, 43.493, 41.903, 40.313, 38.723, 37.134, 35.544, 33.954, 32.364, 30.775, 29.185, 27.595, 26.005, 24.416, 22.826, 21.236, 19.646, 18.057, 16.467, 14.877, 13.287, 11.698, 10.108, 8.518, 6.928, 5.338, 3.749, 2.159, 0.569, -1.021, -2.610, -4.200, -5.790, -7.380, -8.969, -10.559, -12.149, -13.739, -15.328, -16.918, -18.508, -20.098, -21.687, -23.277, -24.867, -26.457, -28.046, -29.636, -31.226, -32.816, -34.406, -35.995, -37.585, -39.175, -40.765, -42.354, -43.944, -45.534, -47.124, -48.713, -50.303, -51.893, -53.483, -55.072, -56.662, -58.252, -59.842, -61.431, -63.021, -64.611, -66.201, -67.790, -69.380, -70.970, -72.560, -74.150, -75.739, -77.329, -78.919, -80.509, -82.098, -83.688, -85.278, -86.868, -88.457, -90.047, -91.637, -93.227, -94.816, -96.406, -97.996, -99.586, -101.175, -102.765, -104.355, -105.945, -107.534, -109.124, -110.714, -112.304, -113.894, -115.483, -117.073, -118.663, -120.253, -121.842, -123.432, -125.022, -126.612, -128.201, -129.791, -131.381, -132.971, -134.560, -136.150, -137.740, -139.330, -140.919, -142.509, -144.099, -145.689, -147.278, -148.868, -150.458, -152.048, -153.638, -155.227, -156.817, -158.407, -159.997, -161.586, -163.176, -164.766, -166.356, -167.945, -169.535, -171.125, -172.715, -174.304, -175.894, -177.484, -179.074, -180.663, -182.253, -183.843, -185.433, -187.022, -188.612, -190.202, -191.792, -193.382, -194.971, -196.561, -198.151, -199.741, -201.330, -202.920, -204.510, -206.100, -207.689, -209.279, -210.869, -212.459, -214.048, -215.638, -217.228, -218.818, -220.407, -221.997, -223.587, -225.177, -226.766, -228.356, -229.946, -231.536, -233.126, -234.715, -236.305, -237.895, -239.485, -241.074, -242.664, -244.254, -245.844, -247.433, -249.023, -250.613, -252.203, -253.792, -255.382, -256.972, -258.562, -260.151, -261.741, -263.331, -264.921, -266.510, -268.100, -269.690, -271.280, -272.870, -274.459, -276.049, -277.639, -279.229, -280.818, -282.408, -283.998, -285.588, -287.177, -288.767, -290.357, -291.947, -293.536, -295.126, -296.716, -298.306, -299.895, -301.485, -303.075, -304.665, -306.254, -307.844, -309.434, -311.024, -312.614, -314.203, -315.793, -317.383, -318.973, -320.562, -322.152, -323.742, -325.332, -326.921, -328.511, -330.101, -331.691, -333.280, -334.870, -336.460, -338.050, -339.639, -341.229, -342.819, -344.409, -345.998, -347.588, -349.178, -350.768, -352.358, -353.947, -355.537, -357.127, -358.717, -360.306, -361.896, -363.486, -365.076, -366.665, -368.255, -369.845, -371.435, -373.024, -374.614, -376.204, -377.794, -379.383, -380.973, -382.563, -384.153, -385.742, -387.332, -388.922, -390.512, -392.102, -393.691, -395.281, -396.871, -398.461, -400.050, -401.640, -403.230, -404.820, -406.409, -407.999, -409.589, -411.179, -412.768, -414.358, -415.948, -417.538, -419.127, -420.717, -422.307, -423.897, -425.486, -427.076, -428.666, -430.256, -431.845, -433.435, -435.025, -436.615, -438.205, -439.794, -441.384, -442.974, -444.564, -446.153, -447.743, -449.333, -450.923, -452.512, -454.102, -455.692, -457.282, -458.871, -460.461, -462.051, -463.641, -465.230, -466.820, -468.410, -470.000, -471.589, -473.179, -474.769, -476.359, -477.949, -479.538, -481.128, -482.718, -484.308, -485.897, -487.487, -489.077, -490.667, -492.256, -493.846, -495.436, -497.026, -498.615, -500.205, -501.795, -503.385, -504.974, -506.564, -508.154, -509.744, -511.333, -512.923, -514.513, -516.103, -517.692, -519.282, -520.872, -522.462, -524.052, -525.641, -527.231, -528.821, -530.411, -532.000, -533.590, -535.180, -536.770, -538.359, -539.949, -541.539, -543.129, -544.718, -546.308, -547.898, -549.488, -551.077, -552.667, -554.257, -555.847, -557.436, -559.026, -560.616, -562.206, -563.796, -565.385, -566.975, -568.565, -570.155, -571.744, -573.334, -574.924, -576.514, -578.103, -579.693, -581.283, -582.873, -584.462, -586.052, -587.642, -589.232, -590.821, -592.411, -594.001, -595.591)

cq_slow(arr, jd) =>
    float pos = (jd - cq_jd0) / cq_step
    int n = array.size(arr)
    int i = math.max(0, math.min(n - 2, int(math.floor(pos))))
    float frac = math.max(0.0, math.min(1.0, pos - i))
    float a = array.get(arr, i)
    float b = array.get(arr, i + 1)
    (a + (b - a) * frac) % 360.0

// ----------------------------------------------------------------------------- compute
float jd  = julianDay()
float T   = (jd - 2451545.0) / 36525.0
float ayan = ayanamsa(T)

float sunTrop  = sunLongitude(T)
float moonTrop = moonLongitude(T)
float sunSid   = norm360(sunTrop - ayan)
float moonSid  = norm360(moonTrop - ayan)
float moonLat  = moonLatitude(T)

float guruSid  = cq_slow(cq_guru, jd)
float shaniSid = cq_slow(cq_shani, jd)
float rahuSid  = cq_slow(cq_rahu, jd)

// --- Panchanga ---------------------------------------------------------------------
float elong    = norm360(moonSid - sunSid)
int   tithiIdx = int(math.floor(elong / TITHI_DEG))              // 0..29
int   tithiNum = (tithiIdx % 15) + 1                             // 1..15
bool  shukla   = tithiIdx < 15
int   nakIdx   = int(math.floor(moonSid / NAK_DEG))              // 0..26
int   padaIdx  = int(math.floor((moonSid % NAK_DEG) / (NAK_DEG / 4.0))) + 1
int   yogaIdx  = int(math.floor(norm360(sunSid + moonSid) / NAK_DEG))
int   karSlot  = int(math.floor(elong / KARANA_DEG))             // 0..59

// Karana identity: Kimstughna at slot 0, the seven chara karanas repeating across
// slots 1..56, then Shakuni, Chatushpada and Naga closing the lunar month.
int karIdx = karSlot == 0 ? 10 : karSlot >= 57 ? 7 + (karSlot - 57) : (karSlot - 1) % 7
bool isVishti = karIdx == 6

bool isPurnima = tithiIdx == 14
bool isAmavasya = tithiIdx == 29
bool isRikta = tithiNum == 4 or tithiNum == 9 or tithiNum == 14

// Gandanta: the water–fire junctions at 0°, 120° and 240°, ±3°20'.
float gdist = math.min(math.min(math.abs(((moonSid - 0.0 + 180.0) % 360.0) - 180.0), math.abs(((moonSid - 120.0 + 180.0) % 360.0) - 180.0)), math.abs(((moonSid - 240.0 + 180.0) % 360.0) - 180.0))
bool inGandanta = gdist <= 3.3333

// Grahana: a syzygy with the Moon inside the ecliptic limit.
bool nearSyzygy = elong < 14.0 or elong > 346.0 or math.abs(elong - 180.0) < 14.0
bool eclipseWindow = nearSyzygy and math.abs(moonLat) < 1.5

// --- Composites ---------------------------------------------------------------------
// Kala Taranga: the cosmic tide. A weighted sum of the aspect geometry between the
// slow grahas and the luminaries, standardised on the chart's own history.
float gsSep = math.abs(((guruSid - shaniSid + 180.0) % 360.0) - 180.0)
float grSep = math.abs(((guruSid - rahuSid + 180.0) % 360.0) - 180.0)
float srSep = math.abs(((shaniSid - rahuSid + 180.0) % 360.0) - 180.0)
float mgSep = math.abs(((moonSid - guruSid + 180.0) % 360.0) - 180.0)
float msSep = math.abs(((moonSid - shaniSid + 180.0) % 360.0) - 180.0)

aspectK(sep, angle, orb) => math.max(0.0, 1.0 - math.abs(sep - angle) / orb)

float ktwRaw = 0.0
ktwRaw := ktwRaw + 1.00 * (aspectK(gsSep, 0.0, 12.0) - aspectK(gsSep, 90.0, 8.0) + aspectK(gsSep, 120.0, 8.0))
ktwRaw := ktwRaw + 0.70 * (aspectK(grSep, 120.0, 8.0) - aspectK(grSep, 0.0, 10.0))
ktwRaw := ktwRaw - 0.90 * aspectK(srSep, 0.0, 10.0)
ktwRaw := ktwRaw + 0.50 * (aspectK(mgSep, 0.0, 8.0) + aspectK(mgSep, 120.0, 7.0))
ktwRaw := ktwRaw - 0.40 * aspectK(msSep, 0.0, 8.0)
ktwRaw := ktwRaw + 0.35 * (shukla ? 1.0 : -1.0)

float ktw = ta.sma(ktwRaw, 5)
float ktwZ = (ktw - ta.sma(ktw, 200)) / math.max(ta.stdev(ktw, 200), 0.0001)

// Bhaya (panic) index: the classical stress terms, 0..1.
float bhyRaw = 0.0
bhyRaw := bhyRaw + (isVishti ? 0.22 : 0.0)
bhyRaw := bhyRaw + (eclipseWindow ? 0.26 : 0.0)
bhyRaw := bhyRaw + (inGandanta ? 0.18 : 0.0)
bhyRaw := bhyRaw + (isRikta ? 0.14 : 0.0)
bhyRaw := bhyRaw + 0.20 * aspectK(srSep, 0.0, 12.0)
bhyRaw := bhyRaw + (shukla ? 0.0 : 0.10)
float bhy = math.min(1.0, bhyRaw)

// --- Regime ---------------------------------------------------------------------------
// Trend and volatility define the regime; the astro layer supplies the risk overlay.
float emaF = ta.ema(close, emaFast)
float emaS = ta.ema(close, emaSlow)
float emaT = ta.ema(close, emaTrend)
float rv   = ta.stdev(ta.roc(close, 1), 20) * math.sqrt(252)
float rvRank = ta.percentrank(rv, 252)

bool trendUp   = close > emaT and emaF > emaS
bool trendDown = close < emaT and emaF < emaS
bool turbulent = rvRank > 85

// 0 Vriddhi, 1 Sthira, 2 Kshaya, 3 Kshobha
int regime = turbulent ? 3 : trendUp ? 0 : trendDown ? 2 : 1

color regimeCol = regime == 0 ? color.new(#22c55e, 88) : regime == 1 ? color.new(#f59e0b, 90) : regime == 2 ? color.new(#ef4444, 88) : color.new(#a855f7, 85)

bgcolor(showBands ? regimeCol : na, title="Regime band")
bgcolor(showEclipse and eclipseWindow ? color.new(#a855f7, 70) : na, title="Grahana window")
bgcolor(showVishti and isVishti ? color.new(#ef4444, 82) : na, title="Vishti karana")

// --- Markers -----------------------------------------------------------------------------
var string[] NAK = array.from("Ashvini","Bharani","Krittika","Rohini","Mrigashira","Ardra","Punarvasu","Pushya","Ashlesha","Magha","P.Phalguni","U.Phalguni","Hasta","Chitra","Svati","Vishakha","Anuradha","Jyeshtha","Mula","P.Ashadha","U.Ashadha","Shravana","Dhanishtha","Shatabhishaj","P.Bhadrapada","U.Bhadrapada","Revati")
var string[] TITHI = array.from("Pratipada","Dvitiya","Tritiya","Chaturthi","Panchami","Shashthi","Saptami","Ashtami","Navami","Dashami","Ekadashi","Dvadashi","Trayodashi","Chaturdashi","Purnima")
var string[] YOGA = array.from("Vishkambha","Priti","Ayushman","Saubhagya","Shobhana","Atiganda","Sukarma","Dhriti","Shula","Ganda","Vriddhi","Dhruva","Vyaghata","Harshana","Vajra","Siddhi","Vyatipata","Variyana","Parigha","Shiva","Siddha","Sadhya","Shubha","Shukla","Brahma","Indra","Vaidhriti")
var string[] KARANA = array.from("Bava","Balava","Kaulava","Taitila","Gara","Vanija","Vishti","Shakuni","Chatushpada","Naga","Kimstughna")
var string[] RASHI = array.from("Mesha","Vrishabha","Mithuna","Karka","Simha","Kanya","Tula","Vrischika","Dhanu","Makara","Kumbha","Meena")

string nakName   = array.get(NAK, nakIdx)
string tithiName = (shukla ? "Shukla " : "Krishna ") + (isAmavasya ? "Amavasya" : array.get(TITHI, tithiNum - 1))
string yogaName  = array.get(YOGA, yogaIdx)
string karName   = array.get(KARANA, karIdx)

bool nakChanged = nakIdx != nakIdx[1]
if showNakLabel and nakChanged and not na(nakIdx[1])
    label.new(bar_index, low, nakName, style=label.style_label_up, color=color.new(#334155, 20), textcolor=#e2e8f0, size=size.tiny)

plotshape(showSyzygy and isPurnima, title="Purnima", style=shape.circle, location=location.abovebar, color=color.new(#fbbf24, 0), size=size.tiny)
plotshape(showSyzygy and isAmavasya, title="Amavasya", style=shape.circle, location=location.abovebar, color=color.new(#475569, 0), size=size.tiny)

// --- Trend plot ---------------------------------------------------------------------------
plot(emaT, "Trend EMA", color=color.new(#64748b, 40), linewidth=1)
plot(emaF, "Fast EMA", color=color.new(#22d3ee, 30), linewidth=1)

// --- Info table -----------------------------------------------------------------------------
var table info = na
if barstate.islast and showTable
    pos = tablePos == "Top right" ? position.top_right : tablePos == "Top left" ? position.top_left : tablePos == "Bottom right" ? position.bottom_right : position.bottom_left
    info := table.new(pos, 2, 13, bgcolor=color.new(#0f172a, 10), border_color=color.new(#334155, 40), border_width=1)
    regimeName = regime == 0 ? "VRIDDHI" : regime == 1 ? "STHIRA" : regime == 2 ? "KSHAYA" : "KSHOBHA"
    regimeTxt  = regime == 0 ? #22c55e : regime == 1 ? #f59e0b : regime == 2 ? #ef4444 : #a855f7

    table.cell(info, 0, 0, "ChandraQuant", text_color=#22d3ee, text_size=size.small)
    table.cell(info, 1, 0, "Kāla-Chakra",  text_color=#94a3b8, text_size=size.small)
    table.cell(info, 0, 1, "Regime",    text_color=#94a3b8, text_size=size.small)
    table.cell(info, 1, 1, regimeName,  text_color=regimeTxt, text_size=size.small)
    table.cell(info, 0, 2, "Tithi",     text_color=#94a3b8, text_size=size.small)
    table.cell(info, 1, 2, tithiName,   text_color=#e2e8f0, text_size=size.small)
    table.cell(info, 0, 3, "Nakshatra", text_color=#94a3b8, text_size=size.small)
    table.cell(info, 1, 3, nakName + " · " + str.tostring(padaIdx), text_color=#e2e8f0, text_size=size.small)
    table.cell(info, 0, 4, "Yoga",      text_color=#94a3b8, text_size=size.small)
    table.cell(info, 1, 4, yogaName,    text_color=#e2e8f0, text_size=size.small)
    table.cell(info, 0, 5, "Karana",    text_color=#94a3b8, text_size=size.small)
    table.cell(info, 1, 5, karName,     text_color=isVishti ? #ef4444 : #e2e8f0, text_size=size.small)
    table.cell(info, 0, 6, "Chandra",   text_color=#94a3b8, text_size=size.small)
    table.cell(info, 1, 6, array.get(RASHI, int(moonSid / 30.0)) + " " + str.tostring(moonSid % 30.0, "#.#") + "°", text_color=#e2e8f0, text_size=size.small)
    table.cell(info, 0, 7, "Surya",     text_color=#94a3b8, text_size=size.small)
    table.cell(info, 1, 7, array.get(RASHI, int(sunSid / 30.0)) + " " + str.tostring(sunSid % 30.0, "#.#") + "°", text_color=#e2e8f0, text_size=size.small)
    table.cell(info, 0, 8, "Guru",      text_color=#94a3b8, text_size=size.small)
    table.cell(info, 1, 8, array.get(RASHI, int(guruSid / 30.0)), text_color=#e2e8f0, text_size=size.small)
    table.cell(info, 0, 9, "Shani",     text_color=#94a3b8, text_size=size.small)
    table.cell(info, 1, 9, array.get(RASHI, int(shaniSid / 30.0)), text_color=#e2e8f0, text_size=size.small)
    table.cell(info, 0, 10, "Kāla Taraṅga", text_color=#94a3b8, text_size=size.small)
    table.cell(info, 1, 10, str.tostring(ktwZ, "#.##"), text_color=ktwZ > 0 ? #22c55e : #ef4444, text_size=size.small)
    table.cell(info, 0, 11, "Bhaya",    text_color=#94a3b8, text_size=size.small)
    table.cell(info, 1, 11, str.tostring(bhy * 100, "#") + "%", text_color=bhy > 0.5 ? #ef4444 : #22c55e, text_size=size.small)
    table.cell(info, 0, 12, "Ayanamsa", text_color=#94a3b8, text_size=size.small)
    table.cell(info, 1, 12, str.tostring(ayan, "#.###") + "°", text_color=#64748b, text_size=size.small)

// --- Alerts ------------------------------------------------------------------------------------
alertcondition(regime != regime[1], "Regime change", "ChandraQuant: regime has shifted")
alertcondition(nakChanged, "Nakshatra change", "ChandraQuant: Chandra enters a new nakshatra")
alertcondition(isVishti and not isVishti[1], "Vishti karana begins", "ChandraQuant: Vishti (Bhadra) — abstention window")
alertcondition(eclipseWindow and not eclipseWindow[1], "Grahana window", "ChandraQuant: eclipse window opens")

// --- Exposed for other scripts --------------------------------------------------------------------
plot(moonSid, "Chandra sidereal", display=display.data_window)
