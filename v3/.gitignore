__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Ephemeris kernels (large binaries, re-downloaded on demand)
data/ephem/*.bsp
data/ephem/*.bpc

# Raw pulls are reproducible; snapshot IS committed as the offline fallback
data/raw/
data/cache/

# Trained models ARE committed - 2 MB each, and shipping them means a fresh clone
# renders a dashboard immediately instead of training on first launch.
# The astro feature cache (data/cache, ~138 MB) and the NASA ephemeris (~31 MB) are
# not committed: both are regenerated by scripts/refresh_data.py.
artifacts/figures/*.png
artifacts/figures/*.html

.ipynb_checkpoints/
.pytest_cache/
.DS_Store
Thumbs.db
